# Variáveis de Ambiente Necessárias para o Projeto "Sistema de Gerenciamento de Caçambas"

# 1. Configuração do Banco de Dados (MySQL)
# Formato: mysql://user:password@host:port/database
DATABASE_URL="mysql://user:password@host:3306/database_name"

# 2. Configuração de Autenticação (OAuth)
# Estes valores são fornecidos pelo provedor OAuth (ex: Manus, Google, etc.)
OAUTH_CLIENT_ID="SEU_CLIENT_ID_AQUI"
OAUTH_CLIENT_SECRET="SEU_CLIENT_SECRET_AQUI"

# 3. Configuração de Serviços AWS (S3 para File Storage)
# Se o projeto usa armazenamento de arquivos
AWS_ACCESS_KEY_ID="SEU_AWS_ACCESS_KEY_ID_AQUI"
AWS_SECRET_ACCESS_KEY="SEU_AWS_SECRET_ACCESS_KEY_AQUI"
AWS_REGION="us-east-1" # Exemplo

# 4. Configuração de Serviços de IA (OpenAI)
# Se o projeto usa funcionalidades de IA
OPENAI_API_KEY="SUA_OPENAI_API_KEY_AQUI"

# 5. Outras Variáveis (Se necessário)
# NODE_ENV="production"
# PORT="3000"
